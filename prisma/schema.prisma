generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  PENDING_CLOSURE
  CLOSED
  CANCELED
}

enum Currency {
  USD
  CUP
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  fullName     String
  passwordHash String
  isActive     Boolean      @default(true)
  roles        UserRole[]
  refreshToken RefreshToken?
  auditLogs    AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  userId     String   @id
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model Establishment {
  id        String      @id @default(cuid())
  name      String
  address   String
  workOrders WorkOrder[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Client {
  id             String      @id @default(cuid())
  name           String
  marginUsdPct   Decimal     @db.Decimal(8, 4)
  marginCupPct   Decimal     @db.Decimal(8, 4)
  workOrders     WorkOrder[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  bccRate      Decimal  @db.Decimal(12, 4)
  informalRate Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
}

model OperationCatalog {
  id                  String    @id @default(cuid())
  description         String
  defaultHours        Decimal?  @db.Decimal(10, 2)
  operations          WorkOrderOperation[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
}

model Operator {
  id                String    @id @default(cuid())
  fullName          String
  salaryUsdPerHour  Decimal   @db.Decimal(12, 4)
  salaryCupPerHour  Decimal   @db.Decimal(12, 4)
  operationWorkers  WorkOrderOperationWorker[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model MachineTool {
  id               String   @id @default(cuid())
  description      String
  valueUsd         Decimal  @db.Decimal(12, 4)
  valueCup         Decimal  @db.Decimal(12, 4)
  depreciationRate Decimal  @db.Decimal(8, 4)
  thdUsd           Decimal  @db.Decimal(12, 6)
  thdCup           Decimal  @db.Decimal(12, 6)
  isAft            Boolean  @default(true)
  operationTools   WorkOrderOperationTool[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
}

model Vehicle {
  id          String      @id @default(cuid())
  plate       String      @unique
  brand       String
  model       String
  year        Int?
  vin         String?
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model WorkOrder {
  id                        String                     @id @default(cuid())
  folio                     String
  status                    WorkOrderStatus           @default(OPEN)
  establishmentId           String
  clientId                  String
  vehicleId                 String
  deliveredBy               String
  receivedBy                String
  receivedAt                DateTime
  requestedActivity         String
  vehicleConditionNotes     String
  visibleIncidents          String
  initialTraceability       String
  cancellationReason        String?
  operations                WorkOrderOperation[]
  consumables               ConsumableEntry[]
  ppas                      PpaEntry[]
  outsourcedServices        OutsourcedServiceEntry[]
  statusHistory             WorkOrderStatusHistory[]
  costSummary               WorkOrderCostSummary?
  establishment             Establishment             @relation(fields: [establishmentId], references: [id])
  client                    Client                    @relation(fields: [clientId], references: [id])
  vehicle                   Vehicle                   @relation(fields: [vehicleId], references: [id])
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  closedAt                  DateTime?
  deletedAt                 DateTime?

  @@unique([establishmentId, folio])
  @@index([status, receivedAt])
  @@index([clientId])
  @@index([vehicleId])
}

model WorkOrderStatusHistory {
  id          String          @id @default(cuid())
  workOrderId String
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  changedBy   String
  changedAt   DateTime        @default(now())
  notes       String?
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id])
}

model WorkOrderOperation {
  id                  String                    @id @default(cuid())
  workOrderId         String
  operationCatalogId  String
  description         String
  operationDate       DateTime
  hours               Decimal                   @db.Decimal(10, 2)
  notes               String?
  workOrder           WorkOrder                 @relation(fields: [workOrderId], references: [id])
  operationCatalog    OperationCatalog          @relation(fields: [operationCatalogId], references: [id])
  workers             WorkOrderOperationWorker[]
  tools               WorkOrderOperationTool[]
  consumables         ConsumableEntry[]
  ppas                PpaEntry[]
  outsourcedServices  OutsourcedServiceEntry[]
}

model WorkOrderOperationWorker {
  id                   String   @id @default(cuid())
  workOrderOperationId String
  operatorId           String
  salaryUsdPerHour     Decimal  @db.Decimal(12, 4)
  salaryCupPerHour     Decimal  @db.Decimal(12, 4)
  hours                Decimal  @db.Decimal(10, 2)
  operation            WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id])
  operator             Operator           @relation(fields: [operatorId], references: [id])
}

model WorkOrderOperationTool {
  id                   String   @id @default(cuid())
  workOrderOperationId String
  machineToolId        String
  thdUsdApplied        Decimal  @db.Decimal(12, 6)
  thdCupApplied        Decimal  @db.Decimal(12, 6)
  hours                Decimal  @db.Decimal(10, 2)
  operation            WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id])
  machineTool          MachineTool        @relation(fields: [machineToolId], references: [id])
}

model ConsumableEntry {
  id                   String    @id @default(cuid())
  workOrderId          String
  workOrderOperationId String?
  date                 DateTime
  voucherNumber        String
  item                 String
  unitMeasure          String
  quantity             Decimal   @db.Decimal(12, 3)
  costUsd              Decimal   @db.Decimal(12, 4)
  costCup              Decimal   @db.Decimal(12, 4)
  notes                String?
  workOrder            WorkOrder @relation(fields: [workOrderId], references: [id])
  operation            WorkOrderOperation? @relation(fields: [workOrderOperationId], references: [id])
}

model PpaEntry {
  id                     String    @id @default(cuid())
  workOrderId            String
  workOrderOperationId   String?
  date                   DateTime
  voucherNumber          String
  item                   String
  unitMeasure            String
  quantity               Decimal   @db.Decimal(12, 3)
  costUsd                Decimal   @db.Decimal(12, 4)
  costCup                Decimal   @db.Decimal(12, 4)
  removedPartEvidenceUrl String?
  removedPartState       String
  removedPartDestination String
  installedPartCondition String
  notes                  String?
  workOrder              WorkOrder @relation(fields: [workOrderId], references: [id])
  operation              WorkOrderOperation? @relation(fields: [workOrderOperationId], references: [id])
}

model OutsourcedServiceEntry {
  id                   String    @id @default(cuid())
  workOrderId          String
  workOrderOperationId String?
  description          String
  provider             String
  date                 DateTime
  costUsd              Decimal   @db.Decimal(12, 4)
  costCup              Decimal   @db.Decimal(12, 4)
  notes                String?
  workOrder            WorkOrder @relation(fields: [workOrderId], references: [id])
  operation            WorkOrderOperation? @relation(fields: [workOrderOperationId], references: [id])
}

model WorkOrderCostSummary {
  id                    String    @id @default(cuid())
  workOrderId           String    @unique
  salaryUsd             Decimal   @db.Decimal(14, 4)
  salaryCup             Decimal   @db.Decimal(14, 4)
  salaryOverheadUsd     Decimal   @db.Decimal(14, 4)
  salaryOverheadCup     Decimal   @db.Decimal(14, 4)
  depreciationUsd       Decimal   @db.Decimal(14, 4)
  depreciationCup       Decimal   @db.Decimal(14, 4)
  outsourcedUsd         Decimal   @db.Decimal(14, 4)
  outsourcedCup         Decimal   @db.Decimal(14, 4)
  consumablesUsd        Decimal   @db.Decimal(14, 4)
  consumablesCup        Decimal   @db.Decimal(14, 4)
  ppaUsd                Decimal   @db.Decimal(14, 4)
  ppaCup                Decimal   @db.Decimal(14, 4)
  totalCostUsd          Decimal   @db.Decimal(14, 4)
  totalCostCup          Decimal   @db.Decimal(14, 4)
  marginUsd             Decimal   @db.Decimal(14, 4)
  marginCup             Decimal   @db.Decimal(14, 4)
  invoiceTotalUsd       Decimal   @db.Decimal(14, 4)
  invoiceTotalCup       Decimal   @db.Decimal(14, 4)
  calculatedAt          DateTime  @default(now())
  workOrder             WorkOrder @relation(fields: [workOrderId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entity, createdAt])
}
